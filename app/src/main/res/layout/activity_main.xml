<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/serviceStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/batteryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp" />

        <Button
            android:id="@+id/openAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/open_accessibility" />

        <Button
            android:id="@+id/disableBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/disable_battery" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/tuning_header" />

        <TextView
            android:id="@+id/distanceLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/distanceSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp" />

        <TextView
            android:id="@+id/durationLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/durationSeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp" />

        <TextView
            android:id="@+id/delayLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <SeekBar
            android:id="@+id/delaySeek"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp" />

        <Switch
            android:id="@+id/volumeSwitch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/volume_mode_label" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/test_header" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/test_hint"
            android:textColor="@color/text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/testUp"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/test_up" />

            <Button
                android:id="@+id/testDown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/test_down" />
        </LinearLayout>

        <TextView
            android:id="@+id/countdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="16sp" />

        <TextView
            style="@style/SectionHeader"
            android:text="@string/setup_header" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/card"
            android:lineSpacingMultiplier="1.15"
            android:padding="14dp"
            android:text="@string/setup_steps"
            android:textColor="@color/text_secondary"
            android:textIsSelectable="true" />
    </LinearLayout>
</ScrollView>
