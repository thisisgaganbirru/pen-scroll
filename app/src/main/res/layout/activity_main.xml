<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="32sp" />

        <TextView
            style="@style/Hint"
            android:layout_marginHorizontal="4dp"
            android:layout_marginTop="2dp"
            android:text="@string/tagline"
            android:textSize="15sp" />

        <!-- Status -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/status_title" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/service_label" />

                <TextView
                    android:id="@+id/serviceStatus"
                    style="@style/Pill" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/RowLabel"
                    android:text="@string/battery_label" />

                <TextView
                    android:id="@+id/batteryStatus"
                    style="@style/Pill" />
            </LinearLayout>

            <TextView
                android:id="@+id/batteryHint"
                style="@style/Hint"
                android:layout_marginTop="8dp"
                android:text="@string/battery_hint" />

            <Button
                android:id="@+id/openAccessibility"
                style="@style/Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/open_accessibility" />

            <Button
                android:id="@+id/disableBattery"
                style="@style/Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/disable_battery" />
        </LinearLayout>

        <!-- Pen button -->
        <LinearLayout style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/pen_button_header" />

            <TextView
                style="@style/ItemTitle"
                android:text="@string/pen_hold_title" />

            <TextView
                style="@style/Hint"
                android:layout_marginTop="2dp"
                android:text="@string/pen_hold_summary" />

            <TextView
                style="@style/ItemTitle"
                android:layout_marginTop="14dp"
                android:text="@string/pen_hold_again_title" />

            <TextView
                style="@style/Hint"
                android:layout_marginTop="2dp"
                android:text="@string/pen_hold_again_summary" />

            <View style="@style/Divider" />

            <TextView
                style="@style/Hint"
                android:text="@string/pen_button_hint" />
        </LinearLayout>

        <!-- Tuning: opens its own screen -->
        <LinearLayout
            android:id="@+id/tuningRow"
            style="@style/Card"
            android:background="@drawable/bg_card_clickable"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/CardTitle"
                    android:layout_marginBottom="2dp"
                    android:text="@string/tuning_header" />

                <TextView
                    style="@style/Hint"
                    android:text="@string/tuning_summary" />
            </LinearLayout>

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_chevron" />
        </LinearLayout>

        <!-- Setup -->
        <LinearLayout
            android:id="@+id/setupCard"
            style="@style/Card">

            <TextView
                style="@style/CardTitle"
                android:text="@string/setup_header" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
