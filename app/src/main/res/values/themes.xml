<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PenScroll" parent="@android:style/Theme.Material">
        <item name="android:colorAccent">#FF7C9CFF</item>
        <item name="android:colorPrimary">#FF1E1F24</item>
        <item name="android:colorPrimaryDark">#FF121316</item>
        <item name="android:windowBackground">@color/background</item>
    </style>

    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">28dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?android:attr/colorAccent</item>
    </style>

    <!-- Translucent.NoTitleBar plus no window animations, so the trampoline never shows. -->
    <style name="Theme.PenScroll.Trampoline" parent="@android:style/Theme.Translucent.NoTitleBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
    </style>
</resources>
